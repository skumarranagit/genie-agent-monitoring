{
  "name": "genie_trace_ingest",
  "description": "Every 30 min: pull Genie Conversation API (messages, agent items, comments) and enrich from system tables into genie_monitoring.message_trace.",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0/30 * * * ?",
    "timezone_id": "America/Chicago",
    "pause_status": "UNPAUSED"
  },
  "parameters": [
    { "name": "space_id", "default": "" },
    { "name": "conversation_id", "default": "" },
    { "name": "lookback_days", "default": "2" },
    { "name": "target_schema", "default": "main.genie_monitoring" }
  ],
  "tasks": [
    {
      "task_key": "ingest",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<you>/genie_monitoring/01_genie_trace_ingest",
        "source": "WORKSPACE"
      },
      "environment_key": "default",
      "timeout_seconds": 1800,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    }
  ],
  "environments": [{ "environment_key": "default", "spec": { "client": "4" } }],
  "tags": { "project": "genie_monitoring" }
}
